NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/logikhata?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=1
LOG_LEVEL=info

JWT_ISSUER=logikhata-api
JWT_AUDIENCE=logikhata-clients
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Generate an RSA key pair and base64-encode each PEM file.
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=

COOKIE_NAME=logikhata_refresh
COOKIE_DOMAIN=
COOKIE_SECURE=false
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

SEED_OWNER_NAME=System Owner
SEED_OWNER_USERNAME=owner
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=ChangeThisBeforeSeeding123!
